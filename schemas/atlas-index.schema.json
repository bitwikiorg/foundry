{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.bitwiki.org/schemas/atlas-index.schema.json",
  "title": "BITwiki Atlas Index",
  "type": "object",
  "required": ["version", "atlases"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": ["string", "null"], "format": "date-time" },
    "atlases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["owner", "name", "repo_url", "atlas_url", "foundry_score", "indexed_at"],
        "properties": {
          "owner": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "repo_url": { "type": "string", "format": "uri" },
          "atlas_url": { "type": "string", "format": "uri" },
          "language": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "github_stars": { "type": "integer", "minimum": 0 },
          "github_forks": { "type": "integer", "minimum": 0 },
          "contributors": { "type": "integer", "minimum": 0 },
          "open_issues": { "type": "integer", "minimum": 0 },
          "last_push_at": { "type": ["string", "null"], "format": "date-time" },
          "indexed_at": { "type": "string", "format": "date-time" },
          "source_commit": { "type": "string" },
          "files": { "type": "integer", "minimum": 0 },
          "loc": { "type": "integer", "minimum": 0 },
          "dependencies": { "type": "integer", "minimum": 0 },
          "foundry_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "score_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_grade": { "enum": ["A", "B", "C", "D", "F", null] },
          "doc_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "test_signal": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "security_signal": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "activity_signal": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "maintainability_signal": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "architecture_signal": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "agent_readiness_signal": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "impressions": { "type": "integer", "minimum": 0 },
          "atlas_queries": { "type": "integer", "minimum": 0 },
          "citations_served": { "type": "integer", "minimum": 0 },
          "themes": { "type": "array", "items": { "type": "string" } },
          "topics": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
